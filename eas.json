{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { 
        "EXPO_PUBLIC_ENVIRONMENT": "development",
        "BUNDLE_SUFFIX": ".dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { 
        "EXPO_PUBLIC_ENVIRONMENT": "preview",
        "BUNDLE_SUFFIX": ".preview"
      }
    },
    "production": {
      "channel": "production",
      "env": { 
        "EXPO_PUBLIC_ENVIRONMENT": "production"
      }
    }
  }
}
