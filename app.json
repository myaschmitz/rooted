{
  "expo": {
    "name": "rooted",
    "slug": "rooted",
    "version": "1.0.0",
    "sdkVersion": "53.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "displayName": "Rooted",
      "supportsTablet": true,
      "bundleIdentifier": "com.myaschm.rooted",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app needs access to your camera to take photos of your plants.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select photos of your plants."
      }
    },
    "android": {
      "displayName": "Rooted",
      "package": "com.myaschm.rooted"
    },
    "web": {},
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ]
    ],
    "scheme": "rooted",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c985d2e8-93a8-4a5d-a7b7-cb59d9e46f11"
      }
    },
    "owner": "myaschm"
  }
}
